# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# Neon dashboard → Connection string (pooled). Keep sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# BETTER_AUTH_SECRET: generate one with  openssl rand -base64 32
# BETTER_AUTH_URL: the public origin of this app (used for OAuth callbacks)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI:  {BETTER_AUTH_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — set only when the auth API is on a different origin than the UI.
# VITE_BETTER_AUTH_URL="http://localhost:3000"
